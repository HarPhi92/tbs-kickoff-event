        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"color-scheme\" content=\"light\" />\n  <meta name=\"supported-color-schemes\" content=\"light\" />\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap\" rel=\"stylesheet\" />\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap');\n    :root { color-scheme: light; supported-color-schemes: light; }\n    body, table, td, div, p, a, h1 { font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important; }\n    @media (prefers-color-scheme: dark) {\n      .tbs-dark-header { background-color: #051D45 !important; }\n      .tbs-dark-header h1, .tbs-dark-wordmark { color: #ffffff !important; }\n      .tbs-dark-sand { color: #D9C9A8 !important; }\n      .tbs-dark-card { background-color: #faf8f3 !important; }\n      .tbs-dark-body { background-color: #ffffff !important; }\n      .tbs-dark-text { color: #051D45 !important; }\n    }\n  </style>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f0ece3; font-family:'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color:#051D45;\">\n  <div class=\"tbs-dark-body\" style=\"max-width:620px; margin:40px auto; background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 2px 20px rgba(5,29,69,0.13);\">\n\n    <!-- HEADER -->\n    <div class=\"tbs-dark-header\" style=\"background-color:#051D45; padding:32px 40px 28px;\">\n      <img src=\"https://myokraft.de/wp-content/uploads/2026/09/TBS-Bildlogo-weiss.png\" alt=\"TBS – Therapie Business School\" style=\"display:block; height:52px; width:auto; margin-bottom:22px;\" />\n      <div style=\"display:inline-block; background:#D9C9A8; color:#051D45; font-size:10px; font-weight:700; letter-spacing:1.4px; text-transform:uppercase; padding:4px 10px; border-radius:4px; margin-bottom:14px;\">\n        ✓ Anmeldung bestätigt\n      </div>\n      <h1 style=\"color:#ffffff; font-size:24px; font-weight:800; line-height:1.3; margin:0 0 6px;\">\n        Partner- &amp; Expertenabend<br><span style=\"color:#D9C9A8;\">22. Oktober 2026 · Kevelaer</span>\n      </h1>\n      <p style=\"color:#b9c2d4; font-size:13px; margin:0;\">Der offizielle Start der Therapie Business School</p>\n    </div>\n\n    <!-- BODY -->\n    <div style=\"padding:32px 40px;\">\n\n      <p style=\"font-size:15.5px; color:#051D45; line-height:1.6; margin:0 0 18px;\">\n        Hallo {{ $('Webhook').item.json.body.firstname }},\n      </p>\n      <p style=\"font-size:14px; color:#3d4a63; line-height:1.8; margin:0 0 26px;\">\n        vielen Dank für deine Anmeldung zum Partner- &amp; Expertenabend der Therapie Business School!\n        Dein Platz ist gesichert – wir freuen uns auf einen persönlichen Abend mit dir.\n      </p>\n\n      <div style=\"font-size:10px; font-weight:800; letter-spacing:1.8px; text-transform:uppercase; color:#051D45; margin-bottom:10px;\">\n        📋 Deine Anmeldung\n      </div>\n      <div style=\"background:#faf8f3; border:1px solid #e7e2d6; border-radius:10px; padding:18px 22px; margin-bottom:24px;\">\n        <table style=\"width:100%; border-collapse:collapse;\">\n          <tr>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#8a8272; font-weight:600; width:175px; padding-right:12px; vertical-align:top;\">Name</td>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#051D45; font-weight:700; vertical-align:top;\">{{ $('Webhook').item.json.body.firstname }} {{ $('Webhook').item.json.body.lastname }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#8a8272; font-weight:600; border-top:1px solid #e7e2d6; padding-right:12px;\">Unternehmen</td>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#051D45; font-weight:700; border-top:1px solid #e7e2d6;\">{{ $('Webhook').item.json.body.company }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#8a8272; font-weight:600; border-top:1px solid #e7e2d6; padding-right:12px;\">Rolle</td>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#051D45; font-weight:700; border-top:1px solid #e7e2d6;\">{{ $('Webhook').item.json.body.role }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#8a8272; font-weight:600; border-top:1px solid #e7e2d6; padding-right:12px;\">Personen</td>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#051D45; font-weight:700; border-top:1px solid #e7e2d6;\">{{ $('Webhook').item.json.body.count }}</td>\n          </tr>\n        </table>\n      </div>\n\n      <div style=\"font-size:10px; font-weight:800; letter-spacing:1.8px; text-transform:uppercase; color:#051D45; margin-bottom:10px;\">\n        📅 Der Abend\n      </div>\n      <div style=\"background:#faf8f3; border:1px solid #e7e2d6; border-radius:10px; padding:18px 22px; margin-bottom:24px;\">\n        <table style=\"width:100%; border-collapse:collapse;\">\n          <tr>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#8a8272; font-weight:600; width:175px; padding-right:12px; vertical-align:top;\">Datum</td>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#051D45; font-weight:700; vertical-align:top;\">Donnerstag, 22. Oktober 2026</td>\n          </tr>\n          <tr>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#8a8272; font-weight:600; border-top:1px solid #e7e2d6; padding-right:12px;\">Uhrzeit</td>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#051D45; font-weight:700; border-top:1px solid #e7e2d6;\">17:00 – 21:00 Uhr</td>\n          </tr>\n          <tr>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#8a8272; font-weight:600; border-top:1px solid #e7e2d6; padding-right:12px;\">Ort</td>\n            <td style=\"padding:8px 0; font-size:13.5px; color:#051D45; font-weight:700; border-top:1px solid #e7e2d6;\">Myokraft · Neustraße 15 · 47623 Kevelaer</td>\n          </tr>\n        </table>\n      </div>\n\n      <div style=\"background:#faf6ec; border:1px solid #D9C9A8; border-left:4px solid #D9C9A8; border-radius:0 8px 8px 0; padding:18px 20px; margin-bottom:24px;\">\n        <div style=\"font-size:10.5px; font-weight:800; letter-spacing:1.4px; text-transform:uppercase; color:#051D45; margin-bottom:10px;\">\n          🅿️ Anreise & Parken\n        </div>\n        <p style=\"font-size:13.5px; color:#3d4a63; line-height:1.75; margin:0;\">\n          Parken in der Tiefgarage Luxemburger Galerie oder direkt vor dem Eingang Luxemburger Galerie.\n          <a href=\"https://www.youtube.com/watch?v=I_Ud7UVIZeI\" style=\"color:#051D45; font-weight:700;\">Video: So findest du unseren Eingang</a>\n        </p>\n      </div>\n\n      <div style=\"text-align:center; margin:24px 0 8px;\">\n        <a href=\"https://www.google.com/maps/search/?api=1&query=Myokraft+Neustra%C3%9Fe+15+47623+Kevelaer\" style=\"display:inline-block; background:#051D45; color:#ffffff; font-size:15px; font-weight:700; padding:15px 38px; border-radius:8px; text-decoration:none; letter-spacing:0.3px;\">\n          Route planen →\n        </a>\n      </div>\n\n      <hr style=\"border:none; border-top:1px solid #ece7db; margin:28px 0;\" />\n\n      <p style=\"font-size:14px; color:#3d4a63; line-height:1.8; margin-bottom:8px;\">\n        Bei Fragen erreichst du uns jederzeit unter\n        <a href=\"mailto:info@therapiebusinessschool.de\" style=\"color:#051D45; font-weight:700;\">info@therapiebusinessschool.de</a>.<br><br>\n        Wir freuen uns auf dich!<br><br>\n        Herzliche Grüße,<br>\n        <strong>Dein Team der Therapie Business School</strong>\n      </p>\n\n    </div>\n\n    <!-- FOOTER -->\n    <div class=\"tbs-dark-header\" style=\"background:#051D45; padding:24px 40px; text-align:center;\">\n      <img src=\"https://myokraft.de/wp-content/uploads/2026/09/TBS-Logo-weiss.png\" alt=\"TBS\" style=\"display:block; height:32px; width:auto; margin:0 auto 12px;\" />\n      <p style=\"color:rgba(255,255,255,0.55); font-size:11px; line-height:1.7; margin:0;\">\n        Therapie Business School · Myokraft, Neustraße 15, 47623 Kevelaer<br>\n        <a href=\"https://kickoff.therapiebusinessschool.de/partnerabend.html\" style=\"color:#D9C9A8;\">kickoff.therapiebusinessschool.de/partnerabend.html</a>\n      </p>\n    </div>\n\n  </div>\n</body>\n</html>",
        "options": {}
      },
